{
  "schemaVersion": 1,
  "runner": "claude",
  "runners": {
    "claude": {
      "breadthModel": "claude-haiku-4-5",
      "investigationModel": "claude-sonnet-5",
      "investigationEffort": "high",
      "skillName": "invariant-first-pr-review",
      "maxTurns": 40,
      "maxBudgetUsd": 3,
      "timeoutMs": 900000
    },
    "codex": {
      "breadthModel": "gpt-5.6-luna",
      "investigationModel": "gpt-5.6-sol",
      "breadthEffort": "low",
      "investigationEffort": "high",
      "skillName": "invariant-first-pr-review",
      "timeoutMs": 900000
    },
    "mock": {}
  },
  "limits": {
    "maxEscalations": 3,
    "maxDiffLines": 1500,
    "minConfidenceToPost": 0.7,
    "maxCommentsPerPr": 5
  },
  "filters": {
    "ignorePaths": [
      "**/package-lock.json",
      "**/pnpm-lock.yaml",
      "**/yarn.lock",
      "**/*.min.js",
      "**/*.map",
      "dist/**",
      "build/**",
      "vendor/**",
      "**/__snapshots__/**"
    ]
  }
}
