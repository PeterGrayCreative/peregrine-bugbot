ef":"https://api.github.com/repos/microsoft/vscode/pulls/66418"}},"reactions":{"url":"https://api.github.com/repos/microsoft/vscode/pulls/comments/255494235/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":226,"side":"RIGHT","author_association":"CONTRIBUTOR","original_position":5,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/microsoft/vscode/pulls/comments/255634079","pull_request_review_id":202264167,"id":255634079,"node_id":"MDI0OlB1bGxSZXF1ZXN0UmV2aWV3Q29tbWVudDI1NTYzNDA3OQ==","diff_hunk":"@@ -222,6 +222,9 @@ export interface IExtensionService extends ICpuProfilerTarget {\n \t * Stops the extension host.\n \t */\n \tstopExtensionHost(): void;\n+\n+\tgetNamedCustomer?(sid: string): any;","path":"src/vs/workbench/services/extensions/common/extensions.ts","commit_id":"ac03e62afcd45cf13e76af0d36a6f85f46f3c2f0","original_commit_id":"f157068e73a44bafdac9c9d2e4ceb1266713627c","user":{"login":"rdeline","id":109971,"node_id":"MDQ6VXNlcjEwOTk3MQ==","avatar_url":"https://avatars.githubusercontent.com/u/109971?v=4","gravatar_id":"","url":"https://api.github.com/users/rdeline","html_url":"https://github.com/rdeline","followers_url":"https://api.github.com/users/rdeline/followers","following_url":"https://api.github.com/users/rdeline/following{/other_user}","gists_url":"https://api.github.com/users/rdeline/gists{/gist_id}","starred_url":"https://api.github.com/users/rdeline/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rdeline/subscriptions","organizations_url":"https://api.github.com/users/rdeline/orgs","repos_url":"https://api.github.com/users/rdeline/repos","events_url":"https://api.github.com/users/rdeline/events{/privacy}","received_events_url":"https://api.github.com/users/rdeline/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Here's how I wired things up. The `CodeInsetController` needs to create a `WebviewInputEditor` in order to pass it to `resolveCodeInset`. This `WebviewInputEditor` needs to be one for which a proxy exists, so that an extension can call methods on it. This is the job of `MainThreadWebviews`. So, to connect the dots between `CodeInsetController` and `MainThreadWebviews`, I added this new method `getNamedCustomer` on `IExtensionService` to allow the following code:\r\n\r\n```\r\n\tprivate getWebviewService(): MainThreadWebviews {\r\n\t\tif (!this._mainThreadWebviews) {\r\n\t\t\tthis._mainThreadWebviews = this._extensionService.getNamedCustomer('MainThreadWebviews');\r\n\t\t}\r\n\t\treturn this._mainThreadWebviews;\r\n\t}\r\n```\r\n\r\nSorry if I'm violating architectural intentions. I'm a n00b. :)","created_at":"2019-02-11T18:24:03Z","updated_at":"2019-02-13T14:20:52Z","html_url":"https://github.com/microsoft/vscode/pull/66418#discussion_r255634079","pull_request_url":"https://api.github.com/repos/microsoft/vscode/pulls/66418","_links":{"self":{"href":"https://api.github.com/repos/microsoft/vscode/pulls/comments/255634079"},"html":{"href":"https://github.com/microsoft/vscode/pull/66418#discussion_r255634079"},"pull_request":{"href":"https://api.github.com/repos/microsoft/vscode/pulls/66418"}},"reactions":{"url":"https://api.github.com/repos/microsoft/vscode/pulls/comments/255634079/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":226,"side":"RIGHT","in_reply_to_id":255494235,"author_association":"CONTRIBUTOR","original_position":5,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/microsoft/vscode/pulls/comments/255992301","pull_request_review_id":202715025,"id":255992301,"node_id":"MDI0OlB1bGxSZXF1ZXN0UmV2aWV3Q29tbWVudDI1NTk5MjMwMQ==","diff_hunk":"@@ -222,6 +222,9 @@ export interface IExtensionService exten