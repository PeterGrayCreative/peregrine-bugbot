[{"url":"https://api.github.com/repos/webpack/webpack/issues/comments/532230368","html_url":"https://github.com/webpack/webpack/issues/9706#issuecomment-532230368","issue_url":"https://api.github.com/repos/webpack/webpack/issues/9706","id":532230368,"node_id":"MDEyOklzc3VlQ29tbWVudDUzMjIzMDM2OA==","user":{"login":"davidroeca","id":6155705,"node_id":"MDQ6VXNlcjYxNTU3MDU=","avatar_url":"https://avatars.githubusercontent.com/u/6155705?v=4","gravatar_id":"","url":"https://api.github.com/users/davidroeca","html_url":"https://github.com/davidroeca","followers_url":"https://api.github.com/users/davidroeca/followers","following_url":"https://api.github.com/users/davidroeca/following{/other_user}","gists_url":"https://api.github.com/users/davidroeca/gists{/gist_id}","starred_url":"https://api.github.com/users/davidroeca/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/davidroeca/subscriptions","organizations_url":"https://api.github.com/users/davidroeca/orgs","repos_url":"https://api.github.com/users/davidroeca/repos","events_url":"https://api.github.com/users/davidroeca/events{/privacy}","received_events_url":"https://api.github.com/users/davidroeca/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-09-17T13:51:46Z","updated_at":"2019-09-17T13:51:46Z","body":"Maybe there could be a way to avoid this warning when certain configurations are set? `hmr` and `watch` come to mind.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/webpack/webpack/issues/comments/532230368/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/webpack/webpack/issues/comments/533984580","html_url":"https://github.com/webpack/webpack/issues/9706#issuecomment-533984580","issue_url":"https://api.github.com/repos/webpack/webpack/issues/9706","id":533984580,"node_id":"MDEyOklzc3VlQ29tbWVudDUzMzk4NDU4MA==","user":{"login":"sokra","id":1365881,"node_id":"MDQ6VXNlcjEzNjU4ODE=","avatar_url":"https://avatars.githubusercontent.com/u/1365881?v=4","gravatar_id":"","url":"https://api.github.com/users/sokra","html_url":"https://github.com/sokra","followers_url":"https://api.github.com/users/sokra/followers","following_url":"https://api.github.com/users/sokra/following{/other_user}","gists_url":"https://api.github.com/users/sokra/gists{/gist_id}","starred_url":"https://api.github.com/users/sokra/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sokra/subscriptions","organizations_url":"https://api.github.com/users/sokra/orgs","repos_url":"https://api.github.com/users/sokra/repos","events_url":"https://api.github.com/users/sokra/events{/privacy}","received_events_url":"https://api.github.com/users/sokra/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-09-23T07:15:57Z","updated_at":"2019-09-23T07:15:57Z","body":"The warning was added to find deeper problems/bugs. Here is what currently happens:\r\n\r\n* webpack-plugin-serve set `output.hotUpdateMainFilename` to a constant string value\r\n* html-webpack-plugin compiles the template with a child compiler\r\n* webpack/HotModuleReplacementPlugin attaches to the `compilation` hook and emits a hot update file for each compilation\r\n  * This unfortunately includes the child compilation from the html-webpack-plugin\r\n* webpack/Compilation merges all assets from child compilations to the root compilation, which causes the conflict warning\r\n\r\nSo there is actually a bug in the HotModuleReplacementPlugin, which should attach to the `thisCompilation` hook instead of `compilation` and only generate hmr update files for the root compilation.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/webpack/webpack/issues/comments/533984580/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/webpack/webpack/issues/comments/534316381","html_url":"https://github.com/webpack/webpack/issues/9706#issuecomment-534316381","issue_url":"https://api.github.com/repos/webpack/webpack/issues/9706","id":534316381,"node_id":"MDEyOklzc3VlQ29tbWVudDUzNDMxNjM4MQ==","user":{"login":"shellscape","id":76371,"node_id":"MDQ6VXNlcjc2Mzcx","avatar_url":"https://avatars.githubusercontent.com/u/76371?v=4","gravatar_id":"","url":"https://api.github.com/users/shellscape","html_url":"https://github.com/shellscape","followers_url":"https://api.github.com/users/shellscape/followers","following_url":"https://api.github.com/users/shellscape/following{/other_user}","gists_url":"https://api.github.com/users/shellscape/gists{/gist_id}","starred_url":"https://api.github.com/users/shellscape/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shellscape/subscriptions","organizations_url":"https://api.github.com/users/shellscape/orgs","repos_url":"https://api.github.com/users/shellscape/repos","events_url":"https://api.github.com/users/shellscape/events{/privacy}","received_events_url":"https://api.github.com/users/shellscape/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-09-23T22:56:18Z","updated_at":"2019-09-23T22:56:18Z","body":"Thank you for addressing this.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/webpack/webpack/issues/comments/534316381/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]