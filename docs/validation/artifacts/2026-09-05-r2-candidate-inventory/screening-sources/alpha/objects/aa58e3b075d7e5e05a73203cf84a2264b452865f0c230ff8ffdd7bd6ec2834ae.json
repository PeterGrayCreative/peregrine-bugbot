","events_url":"https://api.github.com/users/vekexasia/events{/privacy}","received_events_url":"https://api.github.com/users/vekexasia/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2019-05-05T18:39:53Z","updated_at":"2019-05-05T18:39:53Z","body":"Hey @SimonSchick Apparently it works with this plain code:\r\n\r\n```ts\r\nimport * as sequelize from 'sequelize';\r\nimport { Sequelize as SSequelize } from 'sequelize';\r\nimport { DefaultScope, Model, Sequelize, Table } from 'sequelize-typescript';\r\n\r\ndescribe('test', () => {\r\n  it('test', async () => {\r\n    // console.log('a');\r\n    @Table({ tableName: 'brocca' })\r\n    @DefaultScope({\r\n      attributes: [[sequelize.literal('meow'), 'aaa']],\r\n    })\r\n    class Brocca extends Model<Brocca> {}\r\n    const bit = new Sequelize({ dialect: 'postgres', logging: true });\r\n    bit.addModels([Brocca]);\r\n    await Brocca.findAll();\r\n\r\n  });\r\n  it('test2', async () => {\r\n    class Brocca extends Model {}\r\n    const s = new SSequelize('test', 'test', 'password', {dialect: 'postgres', logging: true});\r\n    Brocca.init({}, {\r\n      defaultScope: {\r\n        attributes: [[sequelize.literal('meow'), 'aaa']],\r\n      },\r\n      sequelize: s,\r\n      tableName: 'brocca',\r\n    });\r\n    console.log('hey');\r\n    await Brocca.findAll();\r\n  });\r\n});\r\n\r\n```\r\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/sequelize/sequelize/issues/comments/489451979/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null,"event":"commented","actor":{"login":"vekexasia","id":200523,"node_id":"MDQ6VXNlcjIwMDUyMw==","avatar_url":"https://avatars.githubusercontent.com/u/200523?v=4","gravatar_id":"","url":"https://api.github.com/users/vekexasia","html_url":"https://github.com/vekexasia","followers_url":"https://api.github.com/u