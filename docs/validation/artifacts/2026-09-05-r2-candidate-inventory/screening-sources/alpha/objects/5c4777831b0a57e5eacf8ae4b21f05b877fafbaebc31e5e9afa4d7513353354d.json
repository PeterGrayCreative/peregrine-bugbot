2","id":335164569,"node_id":"MDEyOklzc3VlQ29tbWVudDMzNTE2NDU2OQ==","user":{"login":"NicolasBiehler","id":768174,"node_id":"MDQ6VXNlcjc2ODE3NA==","avatar_url":"https://avatars.githubusercontent.com/u/768174?v=4","gravatar_id":"","url":"https://api.github.com/users/NicolasBiehler","html_url":"https://github.com/NicolasBiehler","followers_url":"https://api.github.com/users/NicolasBiehler/followers","following_url":"https://api.github.com/users/NicolasBiehler/following{/other_user}","gists_url":"https://api.github.com/users/NicolasBiehler/gists{/gist_id}","starred_url":"https://api.github.com/users/NicolasBiehler/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/NicolasBiehler/subscriptions","organizations_url":"https://api.github.com/users/NicolasBiehler/orgs","repos_url":"https://api.github.com/users/NicolasBiehler/repos","events_url":"https://api.github.com/users/NicolasBiehler/events{/privacy}","received_events_url":"https://api.github.com/users/NicolasBiehler/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-10-09T13:52:10Z","updated_at":"2017-10-09T13:52:22Z","body":"It appears that you are right:\r\n\r\n```js\r\nElement.filterByNonArchivedUsers = function (where) {\r\n    return this.findAll({\r\n      where,\r\n      include: [\r\n        {\r\n          model: User,\r\n          required: true,\r\n          include: [\r\n            {\r\n              model: Folder,\r\n              where: {\r\n                name: { $ne: 'archive' }\r\n              }\r\n            }\r\n          ]\r\n        }\r\n      ]\r\n    })\r\n  }\r\n```\r\n\r\nThis gives the correct result.\r\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/sequelize/sequelize/issues/comments/335164569/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repo