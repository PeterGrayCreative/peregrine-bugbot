ent.com/u/9922563?v=4","gravatar_id":"","url":"https://api.github.com/users/ryouaki","html_url":"https://github.com/ryouaki","followers_url":"https://api.github.com/users/ryouaki/followers","following_url":"https://api.github.com/users/ryouaki/following{/other_user}","gists_url":"https://api.github.com/users/ryouaki/gists{/gist_id}","starred_url":"https://api.github.com/users/ryouaki/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ryouaki/subscriptions","organizations_url":"https://api.github.com/users/ryouaki/orgs","repos_url":"https://api.github.com/users/ryouaki/repos","events_url":"https://api.github.com/users/ryouaki/events{/privacy}","received_events_url":"https://api.github.com/users/ryouaki/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-08-27T03:51:51Z","updated_at":"2018-08-27T03:51:51Z","body":"@nickuraltsev could you help me?","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/axios/axios/issues/comments/416106891/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/axios/axios/issues/comments/417887716","html_url":"https://github.com/axios/axios/pull/1752#issuecomment-417887716","issue_url":"https://api.github.com/repos/axios/axios/issues/1752","id":417887716,"node_id":"MDEyOklzc3VlQ29tbWVudDQxNzg4NzcxNg==","user":{"login":"RikkiGibson","id":5833655,"node_id":"MDQ6VXNlcjU4MzM2NTU=","avatar_url":"https://avatars.githubusercontent.com/u/5833655?v=4","gravatar_id":"","url":"https://api.github.com/users/RikkiGibson","html_url":"https://github.com/RikkiGibson","followers_url":"https://api.github.com/users/RikkiGibson/followers","following_url":"https://api.github.com/users/RikkiGibson/following{/other_user}","gists_url":"https://api.github.com/users/RikkiGibson/gists{/gist_id}","starred_url":"https://api.github.com/users/RikkiGibson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/RikkiGibson/subscriptions","organizations_url":"https://api.github.com/users/RikkiGibson/orgs","repos_url":"https://api.github.com/users/RikkiGibson/repos","events_url":"https://api.github.com/users/RikkiGibson/events{/privacy}","received_events_url":"https://api.github.com/users/RikkiGibson/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-09-01T21:19:00Z","updated_at":"2018-09-01T21:19:00Z","body":"It looks like [request.setTimeout](https://nodejs.org/api/http.html#http_request_settimeout_timeout_callback) sets a *read timeout* handler on the underlying socket. It's not the same thing as a request timeout.\r\n\r\nIs the issue is that aborting a request before the connection is established doesn't properly dispose of the socket?","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/axios/axios/issues/comments/417887716/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/axios/axios/issues/comments/417978260","html_url":"https://github.com/axios/axios/pull/1752#issuecomment-417978260","issue_url":"https://api.github.com/repos/axios/axios/issues/1752","id":417978260,"node_id":"MDEyOklzc3VlQ29tbWVudDQxNzk3ODI2MA==","user":{"login":"ryouaki","id":9922563,"node_id":"MDQ6VXNlcjk5MjI1NjM=","avatar_url":"https://avatars.githubusercontent.com/u/9922563?v=4","gravatar_id":"","url":"https://api.github.com/users/ryouaki","html_url":"https://github.com/ryouaki","followers_url":"https://api.github.com/users/ryouaki/followers","following_url":"https://api.github.com/users/ryouaki/following{/other_user}","gists_url":"https://api.github.com/users/ryouaki/gists{/gist_id}","starred_url":"https://api.github.com/users/ryouaki/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ryouaki/subscriptions","organizations_url":"https://api.github.com/users/ryouaki/orgs","repos_url":"https://api.github.com/users/ryouaki/repos","events_url":"https://api.github.com/users/ryouaki/events{/privacy}","received_events_url":"https://api.github.com/users/ryouaki/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-09-03T01:42:02Z","updated_at":"2018-09-03T01:46:29Z","body":"@RikkiGibson Yes，abort a request before the connection, and does not release socket.\r\n\r\nWhen the server side is too slow and no responed for a long time, sometimes setTimeout will be invoked before connection, and \"socket hang up\" will be got. This only appear at connection does not block setTimeout.\r\n\r\nI think for Borwser the request timeout is not the same as connection timeout, But on nodejs I think it is the same. and sometimes the connection block setTimeout. So if we set 10s for timeout ,but the connection block the event loop about 20s, the setTimeout will be fire after 20s.\r\n\r\n```md\r\npoll: retrieve new I/O events; execute I/O related callbacks (almost all with the exception of close callbacks, the ones scheduled by timers, and setImmediate()); node will block here when appropriate.\r\n``` ","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/axios/axios/issues/comments/417978260/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/axios/axios/issues/comments/418484583","html_url":"https://github.com/axios/axios/pull/1752#issuecomment-418484583","issue_url":"https://api.github.com/repos/axios/axios/issues/1752","id":418484583,"node_id":"MDEyOklzc3VlQ29tbWVudDQxODQ4NDU4Mw==","user":{"login":"RikkiGibson","id":5833655,"node_id":"MDQ6VXNlcjU4MzM2NTU=","avatar_url":"https://avatars.githubusercontent.com/u/5833655?v=4","gravatar_id":"","url":"https://api.github.com/users/RikkiGibson","html_url":"https://github.com/RikkiGibson","followers_url":"https://api.github.com/users/RikkiGibson/followers","following_url":"https://api.github.com/users/RikkiGibson/following{/other_user}","gists_url":"https://api.github.com/users/RikkiGibson/gists{/gist_id}","starred_url":"https://api.github.com/users/RikkiGibson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/RikkiGibson/subscriptions","organizations_url":"https://api.github.com/users/RikkiGibson/orgs","repos_url":"https://api.github.com/users/RikkiGibson/repos","events_url":"https://api.github.com/users/RikkiGibson/events{/privacy}","received_events_url":"https://api.github.com/users/RikkiGibson/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-09-04T19:12:41Z","updated_at":"2018-09-04T19:12:41Z","body":"The request timeout applies to receiving the entire HTTP response.\r\n\r\nThe [socket timeout](https://nodejs.org/api/net.html#net_socket_settimeout_timeout_callback), set by request.setTimeout, applies to any activity on the socket (individual reads and writes). The browser doesn't provide any way to set this.\r\n\r\nI said \"read timeout\" previously because a lot of languages will let you configure read and write timeouts separately, while node appear to combine them into one. Sorry for any confusion.\r\n\r\nLet's use the `setTimeout` function like before so that we don't change the meaning of the timeout property. In the timeout handler, we can do something like the following:\r\n\r\n```js\r\nif (request.socket.connecting) {\r\n  request.socket.on('connect', function() {\r\n    request.abort();\r\n  }\r\n} else {\r\n  request.abort();\r\n}\r\n```\r\n\r\nDoes that seem reasonable?","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/axios/axios/issues/comments/418484583/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/axios/axios/issues/comments/418575943","html_url":"https://github.com/axios/axios/pull/1752#issuecomment-418575943","issue_url":"https://api.github.com/repos/axios/axios/issues/1752","id":418575943,"node_id":"MDEyOklzc3VlQ29tbWVudDQxODU3NTk0Mw==","user":{"login":"ryouaki","id":9922563,"node_id":"MDQ6VXNlcjk5MjI1NjM=","avatar_url":"https://avatars.githubusercontent.com/u/9922563?v=4","gravatar_id":"","url":"https://api.github.com/users/ryouaki","html_url":"https://github.com/ryouaki","followers_url":"https://api.github.com/users/ryouaki/followers","following_url":"https://api.github.com/users/ryouaki/following{/other_user}","gists_url":"https://api.github.com/users/ryouaki/gists{/gist_id}","starred_url":"https://api.github.com/users/ryouaki/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ryouaki/subscriptions","organizations_url":"https://api.github.com/users/ryouaki/orgs","repos_url":"https://api.github.com/users/ryouaki/repos","events_url":"https://api.github.com/users/ryouaki/events{/privacy}","received_events_url":"https://api.github.com/users/ryouaki/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-09-05T02:08:21Z","updated_at":"2018-09-05T02:08:21Z","body":"@RikkiGibson Thank you for your explain, \r\n\r\nMaybe my english is not good enough. Yes you want to do timeout like borwser .But sometimes the io event will block setTimeout. the setTimeout will not be invoked in time.\r\n\r\nfor my case like I said before:\r\n1. I set 10s for timeout by setTimeout function.\r\n2. Send a request to a low server . and the server very busy. and no respond.\r\n3. The connection will block setTimeout function. until connection finish. [Nodejs event loop](https://nodejs.org/en/docs/guides/event-loop-timers-and-nexttick/)\r\n4. Connection finish after 20s, the setTimeout function will be invoked after 20s.\r\n\r\nSo, when connection block setTimeout function, The timeout will be fired more than millseconds you set before.\r\n\r\nThis is my problem.\r\n\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/axios/axios/issues/comments/418575943/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/axios/axios/issues/comments/420123948","html_url":"https://github.com/axios/axios/pull/1752#issuecomment-420123948","issue_url":"https://api.github.com/repos/axios/axios/issues/1752","id":420123948,"node_id":"MDEyOklzc3VlQ29tbWVudDQyMDEyMzk0OA==","user":{"login":"ryouaki","id":9922563,"node_id":"MDQ6VXNlcjk5MjI1NjM=","avatar_url":"https://avatars.githubusercontent.com/u/9922563?v=4","gravatar_id":"","url":"https://api.github.com/users/ryouaki","html_url":"https://github.com/ryouaki","followers_url":"https://api.github.com/users/ryouaki/followers","following_url":"https://api.github.com/users/ryouaki/following{/other_user}","gists_url":"https://api.github.com/users/ryouaki/gists{/gist_id}","starred_url":"https://api.github.com/users/ryouaki/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ryouaki/subscriptions","organizations_url":"https://api.github.com/users/ryouaki/orgs","repos_url":"https://api.github.com/users/ryouaki/repos","events_url":"https://api.github.com/users/ryouaki/events{/privacy}","received_events_url":"https://api.github.com/users/ryouaki/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-09-11T02:20:08Z","updated_at":"2018-09-11T02:20:08Z","body":"Nobody else?","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/axios/axios/issues/comments/420123948/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"