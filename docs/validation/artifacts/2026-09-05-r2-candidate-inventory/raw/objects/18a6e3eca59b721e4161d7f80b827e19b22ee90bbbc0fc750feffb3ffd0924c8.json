 you find the time to keep it up!","reactions":{"url":"https://api.github.com/repos/OptimalBits/bull/issues/1686/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/OptimalBits/bull/issues/1686/timeline","performed_via_github_app":null,"state_reason":null,"score":1.0},{"url":"https://api.github.com/repos/OptimalBits/bull/issues/1716","repository_url":"https://api.github.com/repos/OptimalBits/bull","labels_url":"https://api.github.com/repos/OptimalBits/bull/issues/1716/labels{/name}","comments_url":"https://api.github.com/repos/OptimalBits/bull/issues/1716/comments","events_url":"https://api.github.com/repos/OptimalBits/bull/issues/1716/events","html_url":"https://github.com/OptimalBits/bull/pull/1716","id":609430528,"node_id":"MDExOlB1bGxSZXF1ZXN0NDExMDEwOTgy","number":1716,"title":"fix: emulate job.update function for sandboxed processors","user":{"login":"JideOsan","id":730364,"node_id":"MDQ6VXNlcjczMDM2NA==","avatar_url":"https://avatars.githubusercontent.com/u/730364?v=4","gravatar_id":"","url":"https://api.github.com/users/JideOsan","html_url":"https://github.com/JideOsan","followers_url":"https://api.github.com/users/JideOsan/followers","following_url":"https://api.github.com/users/JideOsan/following{/other_user}","gists_url":"https://api.github.com/users/JideOsan/gists{/gist_id}","starred_url":"https://api.github.com/users/JideOsan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/JideOsan/subscriptions","organizations_url":"https://api.github.com/users/JideOsan/orgs","repos_url":"https://api.github.com/users/JideOsan/repos","events_url":"https://api.github.com/users/JideOsan/events{/privacy}","received_events_url":"https://api.github.com/users/JideOsan/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":2941098091,"node_id":"MDU6TGFiZWwyOTQxMDk4MDkx","url":"https://api.github.com/repos/OptimalBits