[{"sha":"15f6609e3f971932ea941feb5d602c5f44dc711a","node_id":"MDY6Q29tbWl0NTIzODk1Mzk6MTVmNjYwOWUzZjk3MTkzMmVhOTQxZmViNWQ2MDJjNWY0NGRjNzExYQ==","commit":{"author":{"name":"Matt Bierner","email":"matb@microsoft.com","date":"2019-06-11T17:26:53Z"},"committer":{"name":"Matt Bierner","email":"matb@microsoft.com","date":"2019-06-11T17:26:53Z"},"message":"Use MutableDisposable in codeLensController\n\nThe `MutableDisposable` class represents a disposable value that can be changed. The class automatically disposeds of the old value when a new one is set, which can prevent a common programming mistake. `MutableDisposable` is useful in places we are currently using `private property?: IDisposable`.\n\nThis change uses a `MutableDisposable` to manage the code lens model.","tree":{"sha":"97091ec832c9a93e1608efbd2d6eda7a488de2c8","url":"https://api.github.com/repos/microsoft/vscode/git/trees/97091ec832c9a93e1608efbd2d6eda7a488de2c8"},"url":"https://api.github.com/repos/microsoft/vscode/git/commits/15f6609e3f971932ea941feb5d602c5f44dc711a","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/microsoft/vscode/commits/15f6609e3f971932ea941feb5d602c5f44dc711a","html_url":"https://github.com/microsoft/vscode/commit/15f6609e3f971932ea941feb5d602c5f44dc711a","comments_url":"https://api.github.com/repos/microsoft/vscode/commits/15f6609e3f971932ea941feb5d602c5f44dc711a/comments","author":null,"committer":null,"parents":[{"sha":"65f4b4a159c9b6c6b3f2bfe0b4fa131ba3bc4918","url":"https://api.github.com/repos/microsoft/vscode/commits/65f4b4a159c9b6c6b3f2bfe0b4fa131ba3bc4918","html_url":"https://github.com/microsoft/vscode/commit/65f4b4a159c9b6c6b3f2bfe0b4fa131ba3bc4918"}]}]