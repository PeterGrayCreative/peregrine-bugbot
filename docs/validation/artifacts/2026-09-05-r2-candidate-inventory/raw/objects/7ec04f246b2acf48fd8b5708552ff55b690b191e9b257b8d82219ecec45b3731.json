po}","subscriptions_url":"https://api.github.com/users/Timer/subscriptions","organizations_url":"https://api.github.com/users/Timer/orgs","repos_url":"https://api.github.com/users/Timer/repos","events_url":"https://api.github.com/users/Timer/events{/privacy}","received_events_url":"https://api.github.com/users/Timer/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":0,"closed_issues":84,"state":"closed","created_at":"2020-01-23T22:13:08Z","updated_at":"2020-04-22T04:27:30Z","due_on":null,"closed_at":"2020-02-18T13:07:53Z"},"comments":9,"created_at":"2020-01-29T21:41:20Z","updated_at":"2022-01-31T11:06:42Z","closed_at":"2020-02-01T14:47:43Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":"resolved","draft":false,"pull_request":{"url":"https://api.github.com/repos/vercel/next.js/pulls/10329","html_url":"https://github.com/vercel/next.js/pull/10329","diff_url":"https://github.com/vercel/next.js/pull/10329.diff","patch_url":"https://github.com/vercel/next.js/pull/10329.patch","merged_at":"2020-02-01T14:47:43Z"},"body":"As discussed with @timneutkens this adds experimental support for `pages/404.js` as a custom 404 page. This allows for more flexibility in creating a custom static 404 page. Having a static 404 page has many benefits like much faster response times, lower loads on your server, and lower hosting costs.\r\n\r\nCurrently this follows the below rules:\r\n- no `getInitialProps` is allowed in `pages/404.js` and throws an error if present\r\n- if no `pages/404.js` is present it falls back to `_error`\r\n- if `_app` has `getInitialProps` and `pages/404.js` is present the 404 page is not static but the custom 404 page is still used\r\n\r\nWith the current implementation static `pages/404.js` should already work with the current `@now/next` and the only change needed there is to add handling for `pages/404.js` as a lambda which should only occur with an `_app` that has custom `getInitialProps`\r\n\r\nx-ref: https://github.com/zeit/now/pull/3697","reactions":{"url":"https://api.github.com/repos/vercel/next.js/issues/10329/reactions","total_count":3,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":3,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/vercel/next.js/issues/10329/timeline","performed_via_github_app":null,"state_reason":null,"score":1.0},{"url":"https://api.github.com/repos/vercel/next.js/issues/10342","repository_url":"https://api.github.com/repos/vercel/next.js","labels_url":"https://api.github.com/repos/vercel/next.js/issues/10342/labels{/name}","comments_url":"https://api.github.com/repos/vercel/next.js/issues/10342/comments","events_url":"https://api.github.com/repos/vercel/next.js/issues/10342/events","html_url":"https://github.com/vercel/next.js/pull/10342","id":557581051,"node_id":"MDExOlB1bGxSZXF1ZXN0MzY5MTQ2Nzc5","number":10342,"title":"Update to not show API not ended warning when response is piped to","user":{"login":"ijjk","id":22380829,"node_id":"MDQ6VXNlcjIyMzgwODI5","avatar_url":"https://avatars.githubusercontent.com/u/22380829?v=4","gravatar_id":"","url":"https://api.github.com/users/ijjk","html_url":"https://github.com/ijjk","followers_url":"https://api.github.com/users/ijjk/followers","following_url":"https://api.github.com/users/ijjk/following{/other_user}","gists_url":"https://api.github.com/users/ijjk/gists{/gist_id}","starred_url":"https://api.github.com/users/ijjk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ijjk/subscriptions","organizations_url":"https://api.github.com/users/ijjk/orgs","repos_url":"https://api.github.com/users/ijjk/repos","events_url":"https://api.github.com/users/ijjk/events{/privacy}","received_events_url":"https://api.github.com/users/ijjk/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"closed","locked":true,"assignees":[],"milestone":{"url":"https://api.github.com/repos/verce