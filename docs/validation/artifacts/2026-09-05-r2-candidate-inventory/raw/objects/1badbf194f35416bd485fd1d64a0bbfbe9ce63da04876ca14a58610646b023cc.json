0:58Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":"resolved","draft":false,"pull_request":{"url":"https://api.github.com/repos/vercel/next.js/pulls/19522","html_url":"https://github.com/vercel/next.js/pull/19522","diff_url":"https://github.com/vercel/next.js/pull/19522.diff","patch_url":"https://github.com/vercel/next.js/pull/19522.patch","merged_at":"2020-11-25T17:20:58Z"},"body":"By default, MobX 6 and later require that you use `actions` to make changes to the state, otherwise, it issues a warning in the console, because the `hydrate` method of the `store.js` class hasn't been declared an action, you can see this warning if you try to load pages that use hydration (ssg, ssr).\r\nThis pull request fixes that.\r\n\r\nMore info about the behavior:\r\nhttps://mobx.js.org/actions.html#disabling-mandatory-actions-","reactions":{"url":"https://api.github.com/repos/vercel/next.js/issues/19522/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/vercel/next.js/issues/19522/timeline","performed_via_github_app":null,"state_reason":null,"score":1.0},{"url":"https://api.github.com/repos/vercel/next.js/issues/19538","repository_url":"https://api.github.com/repos/vercel/next.js","labels_url":"https://api.github.com/repos/vercel/next.js/issues/19538/labels{/name}","comments_url":"https://api.github.com/repos/vercel/next.js/issues/19538/comments","events_url":"https://api.github.com/repos/vercel/next.js/issues/19538/events","html_url":"https://github.com/vercel/next.js/pull/19538","id":751105710,"node_id":"MDExOlB1bGxSZXF1ZXN0NTI3NjgyNjYz","number":19538,"title":"fix(next): always enable absoluteRuntime when running under webpack","user":{"login":"merceyz","id":3842800,"node_id":"MDQ6VXNlcjM4NDI4MDA=","avatar_url":"https://avatars.githubusercontent.com/u/3842800?v=4","gravatar_id":"","url":"https://api.github.com/users/