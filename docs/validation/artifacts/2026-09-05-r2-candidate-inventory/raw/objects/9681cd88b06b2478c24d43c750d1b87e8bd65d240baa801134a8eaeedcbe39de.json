OQ==","diff_hunk":"@@ -125,7 +129,7 @@ class Transaction {\n         throw setupErr;\n       }))\n       .tap(() => {\n-        if (this.sequelize.constructor._cls) {\n+        if (useCLS && this.sequelize.constructor._cls) {","path":"lib/transaction.js","commit_id":"a2d0c10a38083958361ff8218a015adcc21e7764","original_commit_id":"bda0df47ebcca4ad06f9eec006d35537ce6deb43","user":{"login":"tylerjwatson","id":5001408,"node_id":"MDQ6VXNlcjUwMDE0MDg=","avatar_url":"https://avatars.githubusercontent.com/u/5001408?v=4","gravatar_id":"","url":"https://api.github.com/users/tylerjwatson","html_url":"https://github.com/tylerjwatson","followers_url":"https://api.github.com/users/tylerjwatson/followers","following_url":"https://api.github.com/users/tylerjwatson/following{/other_user}","gists_url":"https://api.github.com/users/tylerjwatson/gists{/gist_id}","starred_url":"https://api.github.com/users/tylerjwatson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tylerjwatson/subscriptions","organizations_url":"https://api.github.com/users/tylerjwatson/orgs","repos_url":"https://api.github.com/users/tylerjwatson/repos","events_url":"https://api.github.com/users/tylerjwatson/events{/privacy}","received_events_url":"https://api.github.com/users/tylerjwatson/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Yes, but if you _do_ call `Sequelize.useCLS` then any manual transaction will clobber an auto transaction if they are nested within eachother.  See failing test below with my changes removed.\r\n\r\nIt's not too unreasonable to want to talk to two separate databases in one procedure and have them both rollback the changes if something does not succeed.  This is indeed the case I am dealing with at the moment.\r\n\r\n```bash\r\n tw@fedora-x1  ~/src/sequelize   cls-on-manual-transactions  DIALECT=sqlite mocha --globals setImmediate,clearImmediate --ui tdd --check-leaks --colors -t 30000 --reporter spec \"test/integration/cls.test.js\"\r\nsequelize deprecated String based operators are now deprecated. Please use Symbol based operators for better security, read more at http://docs.sequelizejs.com/manual/tutorial/querying.html#operators lib/sequelize.js:236:13\r\n\r\n\r\n  [SQLITE] Continuation local storage\r\n    ✓ bluebird patch is applied\r\n    ✓ CLS namespace is stored in Sequelize._cls\r\n    context\r\n      1) does not use continuation storage on manually managed transactions\r\n      ✓ supports several concurrent transactions\r\n      ✓ supports nested promise chains\r\n      ✓ does not leak variables to the outer scope (206ms)\r\n      ✓ does not leak variables to the following promise chain\r\n      ✓ does not leak outside findOrCreate (87ms)\r\n    sequelize.query integration\r\n      ✓ automagically uses the transaction in all calls (78ms)\r\n\r\n\r\n  8 passing (1s)\r\n  1 failing\r\n\r\n  1) [SQLITE] Continuation local storage context does not use continuation storage on manually managed transactions:\r\n     AssertionError: expected { Object (sequelize, savepoints, ...) } to be undefined\r\n```","created_at":"2017-10-05T23:32:31Z","updated_at":"2017-10-09T08:50:12Z","html_url":"https://github.com/sequelize/sequelize/pull/8430#discussion_r143082009","pull_request_url":"https://api.github.com/repos/sequelize/sequelize/pulls/8430","_links":{"self":{"href":"https://api.github.com/repos/sequelize/sequelize/pulls/comments/143082009"},"html":{"href":"https://github.com/sequelize/sequelize/pull/8430#discussion_r143082009"},"pull_request":{"href":"https://api.github.com/repos/sequelize/sequelize/pulls/8430"}},"reactions":{"url":"https://api.github.com/repos/sequelize/sequelize/pulls/comments/143082009/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":132,"original_line":132,"side":"RIGHT","in_reply_to_id":142979112,"author_association":"CONTRIBUTOR","ori