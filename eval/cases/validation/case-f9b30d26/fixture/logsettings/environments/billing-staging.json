{
  "schemaVersion": 1,
  "profile": "billing-staging",
  "service": "billing",
  "deployment": {
    "environment": "staging",
    "region": "us-west",
    "ownerGroup": "platform-observability",
    "tier": "standard"
  },
  "environment": {
    "LOG_LEVEL": "info",
    "LOG_FORMAT": "json",
    "LOG_PROPAGATE": "false",
    "LOG_HANDLERS": "console"
  },
  "retention": {
    "days": 14,
    "maxFiles": 5,
    "compress": false,
    "legalHold": false
  },
  "sampling": {
    "requestRate": 0.50,
    "errorRate": 1.00,
    "healthRate": 0.10,
    "metricsRate": 0.10
  },
  "redaction": {
    "fields": [
      "authorization",
      "cookie",
      "email",
      "session_id",
      "user_token"
    ],
    "replacement": "[redacted]"
  },
  "routing": {
    "primary": "central-us-west",
    "secondary": "archive-us-west",
    "deadLetter": "logging-failures-us-west"
  },
  "labels": {
    "team": "billing",
    "costCenter": "cc-4105",
    "dataClass": "internal"
  }
}
