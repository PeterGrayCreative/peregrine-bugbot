{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Peregrine Experiment Terminal Seal",
  "$comment": "Structural schema only. parseExperimentTerminalSeal and requireValidExperimentTerminalSeal are authoritative for self-authentication and artifact digest validation.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "experiment-terminal" },
    "experimentId": { "$ref": "#/$defs/sha256" },
    "experimentManifestSha256": { "$ref": "#/$defs/sha256" },
    "terminal": { "enum": ["completed", "stopped"] },
    "sealedAt": { "$ref": "#/$defs/canonicalTimestamp" },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "sealSha256": { "$ref": "#/$defs/sha256" }
  },
  "required": ["schemaVersion", "kind", "experimentId", "experimentManifestSha256", "terminal", "sealedAt", "artifacts", "sealSha256"],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "canonicalTimestamp": {
      "type": "string",
      "pattern": "^(?:[0-9]{4}|[+-][0-9]{6})-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?:matrix-manifest\\.json|experiment-manifest\\.json|experiment-stop\\.json|state/attempt-[0-9]{6}\\.(?:started|provider-started)\\.json|attempt-[0-9]{6}\\.json)$"
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "required": ["path", "sha256"]
    }
  }
}
