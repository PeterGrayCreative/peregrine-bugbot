{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Peregrine Behavioral Benchmark Curation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "status", "curatorPolicyId", "source", "strata", "proof", "confirmations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "caseId": { "type": "string", "pattern": "^case-[a-f0-9]{8,32}$" },
    "status": { "enum": ["draft", "admitted"] },
    "curatorPolicyId": { "const": "protected-git-review-v1" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repositoryAlias", "repositoryIdentitySha256", "changeIdentitySha256", "access"],
      "properties": {
        "kind": { "enum": ["historical", "seeded", "clean"] },
        "repositoryAlias": { "$ref": "#/$defs/slug" },
        "repositoryIdentitySha256": { "$ref": "#/$defs/sha256" },
        "changeIdentitySha256": { "$ref": "#/$defs/sha256" },
        "access": { "enum": ["public", "sanitized-private", "curator-local-private"] }
      }
    },
    "strata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["languageFamily", "architectureFamily", "size", "changeShapes", "surfaceLanes"],
      "properties": {
        "languageFamily": { "$ref": "#/$defs/slug" },
        "architectureFamily": { "enum": ["backend-service", "cli-tool", "data-pipeline", "frontend-application", "infrastructure", "library", "worker-service"] },
        "size": { "enum": ["small", "medium", "large"] },
        "changeShapes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["direct", "seam", "multi-observation", "large-diff"] }
        },
        "surfaceLanes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/lane" }
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "artifact", "sha256"],
      "properties": {
        "kind": { "enum": ["regression-test", "reproduction", "reasoned-analysis", "clean-control-review"] },
        "artifact": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\).+$" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "confirmations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["curatorIdentitySha256", "confirmedAt", "caseBundleSha256", "checks"],
        "properties": {
          "curatorIdentitySha256": { "$ref": "#/$defs/sha256" },
          "confirmedAt": { "type": "string", "format": "date-time" },
          "caseBundleSha256": { "$ref": "#/$defs/sha256" },
          "checks": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": ["classification", "clean-control", "consequentiality", "disposition", "line-range", "provenance", "reachability", "root-cause", "severity", "source-authenticity", "truth-completeness"]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,47}$" },
    "lane": { "enum": ["authorization", "identifiers", "data-integrity", "persistence", "runtime-config", "contracts", "concurrency", "test-quality", "logic-correctness", "error-handling", "frontend-state", "boundaries-pagination"] }
  }
}
