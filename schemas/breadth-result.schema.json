{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Peregrine Breadth Sweep",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "model": { "type": "string", "minLength": 1 },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 120 },
          "file": { "type": "string", "minLength": 1 },
          "line": { "type": "integer", "minimum": 1 },
          "lane": { "type": "string", "minLength": 1 },
          "invariant": { "type": "string", "minLength": 1 },
          "counterexample": { "type": "string", "minLength": 1 },
          "evidenceNeeded": { "type": "string", "minLength": 1 }
        },
        "required": ["id", "file", "line", "lane", "invariant", "counterexample", "evidenceNeeded"]
      }
    },
    "clear": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "lane": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        },
        "required": ["lane", "file", "reason"]
      }
    },
    "escalations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "target": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        },
        "required": ["target", "reason"]
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coveredFiles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "unavailable": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": ["coveredFiles", "unavailable"]
    }
  },
  "required": ["model", "candidates", "clear", "escalations", "coverage"]
}
