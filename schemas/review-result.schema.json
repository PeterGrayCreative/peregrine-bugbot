{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Peregrine Review Output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "startLine": { "type": "integer", "minimum": 1 },
          "endLine": { "type": "integer", "minimum": 1 },
          "severity": { "enum": ["high", "medium", "low"] },
          "disposition": { "enum": ["fix-in-pr", "follow-up"] },
          "category": {
            "enum": [
              "authorization",
              "identifiers",
              "data-integrity",
              "persistence",
              "runtime-config",
              "contracts",
              "concurrency",
              "test-quality",
              "logic",
              "other"
            ]
          },
          "title": { "type": "string", "minLength": 1, "maxLength": 300 },
          "explanation": { "type": "string", "minLength": 1, "maxLength": 8000 },
          "failurePath": { "type": "string", "minLength": 1, "maxLength": 8000 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "required": [
          "file",
          "startLine",
          "endLine",
          "severity",
          "disposition",
          "category",
          "title",
          "explanation",
          "failurePath",
          "confidence"
        ]
      }
    }
  },
  "required": ["findings"]
}
