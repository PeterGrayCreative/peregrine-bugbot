{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peregrine.local/schemas/curator-policy.schema.json",
  "title": "Behavioral corpus curator policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyId", "trustRoot", "minimumIndependentConfirmations", "curatorIdentitySha256s"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "policyId": { "const": "protected-git-review-v1" },
    "trustRoot": { "const": "protected-git-review" },
    "minimumIndependentConfirmations": { "const": 2 },
    "curatorIdentitySha256s": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    }
  }
}
