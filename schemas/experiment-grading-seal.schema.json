{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Peregrine Experiment Grading Seal",
  "$comment": "Structural schema only. parseExperimentGradingSeal and requireValidExperimentGradingSeal are authoritative for self-authentication and completed-grade digest validation.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "experiment-grading" },
    "experimentId": { "$ref": "#/$defs/sha256" },
    "experimentManifestSha256": { "$ref": "#/$defs/sha256" },
    "terminalSealSha256": { "$ref": "#/$defs/sha256" },
    "sealedAt": { "$ref": "#/$defs/canonicalTimestamp" },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    },
    "sealSha256": { "$ref": "#/$defs/sha256" }
  },
  "required": ["schemaVersion", "kind", "experimentId", "experimentManifestSha256", "terminalSealSha256", "sealedAt", "artifacts", "sealSha256"],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "canonicalTimestamp": {
      "type": "string",
      "pattern": "^(?:[0-9]{4}|[+-][0-9]{6})-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "pattern": "^attempt-[0-9]{6}\\.graded\\.json$" },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "required": ["path", "sha256"]
    }
  }
}
