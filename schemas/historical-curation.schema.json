{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Structural validation only. Admission MUST use readHistoricalCaseAdmission for truth-derived multi-observation and mechanism checks, diff-derived size and large-diff checks, canonical proof isolation, an external trusted curator policy, and authenticated source-history gates.",
  "title": "Peregrine Historical Efficacy Curation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protocol", "caseId", "status", "curatorPolicyId", "truth", "source", "strata", "proof", "confirmations"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "protocol": { "const": "historical-efficacy-v1" },
    "caseId": { "type": "string", "pattern": "^case-[a-f0-9]{8,32}$" },
    "status": { "enum": ["draft", "admitted"] },
    "curatorPolicyId": { "const": "protected-git-review-v1" },
    "truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["truthVersion", "status", "completeness", "scopeSha256"],
      "properties": {
        "truthVersion": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "status": { "enum": ["known-roots", "reviewed-comparison"] },
        "completeness": { "const": "partial" },
        "scopeSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repositoryAlias", "repositoryIdentitySha256", "changeIdentitySha256", "access"],
      "properties": {
        "kind": { "const": "historical" },
        "repositoryAlias": { "$ref": "#/$defs/slug" },
        "repositoryIdentitySha256": { "$ref": "#/$defs/sha256" },
        "changeIdentitySha256": { "$ref": "#/$defs/sha256" },
        "access": { "enum": ["public", "sanitized-private", "curator-local-private"] }
      }
    },
    "strata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["languageFamily", "architectureFamily", "size", "changeShapes", "secondarySurfaceLanes", "mechanismFamilies"],
      "properties": {
        "languageFamily": { "enum": ["javascript", "typescript"] },
        "architectureFamily": { "enum": ["backend-service", "cli-tool", "data-pipeline", "frontend-application", "infrastructure", "library", "worker-service"] },
        "size": { "enum": ["small", "medium", "large"] },
        "changeShapes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["direct", "large-diff", "multi-observation", "seam"] } },
        "secondarySurfaceLanes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/lane" } },
        "mechanismFamilies": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "artifact", "sha256"],
      "properties": {
        "kind": { "enum": ["reasoned-analysis", "regression-test", "reproduction", "reviewed-comparison-analysis"] },
        "artifact": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f]).+$" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "confirmations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["curatorIdentitySha256", "confirmedAt", "caseBundleSha256", "truthScopeSha256", "checks"],
        "properties": {
          "curatorIdentitySha256": { "$ref": "#/$defs/sha256" },
          "confirmedAt": { "type": "string", "format": "date-time" },
          "caseBundleSha256": { "$ref": "#/$defs/sha256" },
          "truthScopeSha256": { "$ref": "#/$defs/sha256" },
          "checks": { "type": "array", "uniqueItems": true, "items": { "enum": ["source-authenticity", "revision-identity", "diff-identity", "proof-integrity", "truth-status", "truth-scope", "partial-truth", "root-evidence", "reviewed-comparison-scope"] } }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "admitted" } }, "required": ["status"] },
      "then": { "properties": { "confirmations": { "minItems": 2 } } }
    },
    {
      "oneOf": [
        {
          "properties": { "strata": { "properties": { "changeShapes": {
            "contains": { "const": "direct" },
            "not": { "contains": { "const": "seam" } }
          } } } }
        },
        {
          "properties": { "strata": { "properties": { "changeShapes": {
            "contains": { "const": "seam" },
            "not": { "contains": { "const": "direct" } }
          } } } }
        }
      ]
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "lane": { "enum": ["authorization", "identifiers", "data-integrity", "persistence", "runtime-config", "contracts", "concurrency", "test-quality", "logic-correctness", "error-handling", "frontend-state", "boundaries-pagination"] }
  }
}
